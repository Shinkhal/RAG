# Required for the API and durable document storage
APP_ENV=development
PORT=8000
DATABASE_URL=postgresql://user:password@localhost:5432/rag
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional infrastructure
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ingestion bounds and durable worker polling
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_SIZE_MB=10
MAX_UPLOADS_PER_HOUR=20
ENABLE_PDF_OCR=false
INGEST_WORKER_POLL_INTERVAL_SECONDS=1
INGEST_WORKER_LEASE_MINUTES=30

# Retrieval and chunking
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_OUTPUT_DIMENSIONALITY=768
MAX_CHUNK_SIZE=2048
CHUNK_OVERLAP=256
DEFAULT_TOP_K=5
MIN_RETRIEVAL_SCORE=0.5
IVFFLAT_PROBES=10
ENABLE_BM25=true
ENABLE_QUERY_REWRITING=false
ENABLE_RERANKING=false
ENABLE_PARENT_CONTEXT=false

# Optional persona administration
PERSONA_ADMIN_TOKEN=
